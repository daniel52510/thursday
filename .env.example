# THURSDAY configuration. Copy to .env (scripts/setup.sh does it and fills the random secrets for you).
# .env is gitignored and never baked into an image: keep real keys here and nowhere else.
# Everything not listed has a sensible default in code (grep os.getenv for the tuning knobs).

# ---------------------------------------------------------------- you
# Your name as THURSDAY says it, your login, and your timezone (alarms, briefings, "today").
THURSDAY_OWNER_NAME=Daniel
THURSDAY_OWNER_USERNAME=daniel
THURSDAY_TZ=America/New_York

# ---------------------------------------------------------------- brain (Ollama, native on the Mac for the GPU)
# The chat model, always loaded. Containers reach the Mac at host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434/api/generate
OLLAMA_MODEL=gemma4:26b
OLLAMA_KEEP_ALIVE=-1
OLLAMA_TIMEOUT=120
# Missions and the self-improvement runner use a bigger model, loaded only while they work.
MISSION_MODEL=gemma4:26b   # one model for everything (2026-11-09 trial); gemma4:31b for deeper missions
RUNNER_MODEL=gemma4:26b

# ---------------------------------------------------------------- voice
# TTS server (native, GPU): 9000 = Qwen TTS (scripts/run_tts_native.sh), 9001 = the Orpheus voice.
THURSDAY_TTS_PORT=9000
# Native speech-to-text (scripts/install_stt_launchd.sh) on :9300; the CPU container is the fallback.
# THURSDAY_STT_URL=http://host.docker.internal:9300
# Rocky's voice character (rocky_voice.py): pitch shift in semitones, chord and "alien" mix.
ROCKY_PITCH_SEMITONES=-1
# ROCKY_CHORD_MIX=
# ROCKY_ALIEN=
# Satellites sign in with a device token from Settings → Devices. VOICE_TOKEN is the old shared one: leave empty.
VOICE_TOKEN=
# Voice ID on the satellite: enforce (sensitive tools need your voice), shadow (log only), off.
SPEAKER_ID=enforce
# Conversation feel (voice_ws.py): smart end-of-turn and "mm-hm" backchannels.
VOICE_SMART_ENDPOINT=1
VOICE_BACKCHANNEL=1
# VOICE_DEBUG_WAV_DIR=   # set to a folder to save every spoken piece before/after Rocky's filter

# ---------------------------------------------------------------- web search and weather
# SearXNG runs in Docker; its secret is random (setup.sh makes one).
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_SECRET=change-me
# Optional: Brave Search API for missions (free tier ~2,000 queries/month; capped at 900 in code).
BRAVE_SEARCH_API_KEY=
OPEN_METEO_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# ---------------------------------------------------------------- phone pushes (ntfy, self-hosted in Docker)
# A long random topic: anyone who knows it can read your pushes. setup.sh makes one.
NTFY_TOPIC=

# ---------------------------------------------------------------- calendar (optional)
# Better: connect it in Settings → You (stored encrypted in the vault, ~/.config/thursday/master.key).
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
ICLOUD_CALENDAR=

# ---------------------------------------------------------------- music and lights (optional)
MUSIC_TAP_TOKEN=
# LIFX bulbs on your LAN, e.g. "Desk=192.168.1.40,Lamp=192.168.1.41"
LIFX_LIGHTS=

# ---------------------------------------------------------------- phone calls (optional, Twilio)
# Off until TWILIO_PUBLIC_URL is set. That needs a public HTTPS address for /twilio only: we use
# `tailscale funnel --bg --https=8443 --set-path=/twilio http://127.0.0.1:8000/twilio` (see SECURITY.md).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Your own phone ("call me").
TWILIO_OWNER_NUMBER=
# TWILIO_PUBLIC_URL=https://your-mac.your-tailnet.ts.net:8443
# 1 = live two-way conversations (Media Streams); 0 = a one-way spoken message.
TWILIO_TWO_WAY=1
# Limits: calls a day, country prefixes allowed, seconds before he wraps up (Twilio cuts at 180).
# TWILIO_DAILY_CALLS=10
# TWILIO_ALLOWED_PREFIXES=+1
# TWILIO_CALL_WRAP_S=150
