<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.thursday.voice</string>
  <key>ProgramArguments</key>
  <array><string>__HOME__/thursday-voice/run_orpheus_server.sh</string></array>
  <key>WorkingDirectory</key><string>__HOME__/thursday-voice</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string><key>ORPHEUS_PORT</key><string>9001</string><key>ORPHEUS_VOICE</key><string>leo</string><key>ORPHEUS_PITCH_CENTS</key><string>-100</string><key>ORPHEUS_PITCH_WINDOW</key><string>30 8 6</string></dict>
  <!-- Start at login and restart if it exits; wait 10 s between attempts. -->
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/thursday/orpheus.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/thursday/orpheus.log</string>
</dict>
</plist>
